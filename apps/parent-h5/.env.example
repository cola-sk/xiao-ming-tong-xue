# ==============================================================================
# 1. 火山引擎「豆包语音」V3 配置（仅需一个 API Key 即可调用豆包 TTS 与复刻音色）
# 控制台地址：https://console.volcengine.com/speech/new/overview
# ==============================================================================
DOUBAO_SPEECH_API_KEY=

# 豆包声音复刻专属音色 ID（在豆包语音控制台「声音复刻」获取，如 S_xxxxxx）
VOLC_SPEAKER_ID_MOM=
VOLC_SPEAKER_ID_DAD=

# 可选：V3 模型资源 ID（代码已内置自动适配 seed-icl-1.0 / volc.megatts.default / seed-tts-1.0 / seed-tts-2.0）
VOLC_V3_CLONE_RESOURCE_ID=seed-icl-1.0
VOLC_V3_TTS_RESOURCE_ID=seed-tts-1.0
VOLC_PET_VOICE_TYPE=zh_female_cancan_mars_bigtts

# ==============================================================================
# 2. AI 对话大模型配置（DeepSeek API 或 火山方舟豆包大模型 OpenAI 兼容接口）
# ==============================================================================
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ==============================================================================
# 3. Supabase 数据库配置（可选）
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
